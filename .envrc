export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv 2>/dev/null

# This file is safe to commit and contains no secrets.
# Nothing fails when the private file is absent, so build and dry-run remain
# usable from a fresh checkout.
#
# Never export COLORS_PAR_PROFILE: profile identifies this deployment.
source_env_if_exists .envrc.private
